<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <TextView android:id="@+id/title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="15sp"
        android:textStyle="bold" android:textColor="@color/ink" android:text="—" />

    <TextView android:id="@+id/sub" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textColor="@color/sub" android:text="—" />

    <TextView android:id="@+id/row1" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textSize="12sp" android:textColor="@color/ink" android:singleLine="true" />

    <TextView android:id="@+id/row2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textColor="@color/ink" android:singleLine="true" />

    <TextView android:id="@+id/row3" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textColor="@color/ink" android:singleLine="true" />

    <TextView android:id="@+id/row4" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textColor="@color/ink" android:singleLine="true" />

    <TextView android:id="@+id/next" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textSize="12sp" android:textStyle="bold" android:textColor="@color/accent" />

    <TextView android:id="@+id/wx" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="11sp"
        android:textColor="@color/sub" />
</LinearLayout>
