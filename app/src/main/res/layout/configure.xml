<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/config_hint" android:textSize="14sp" />

    <EditText android:id="@+id/url" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:inputType="textUri" android:textSize="14sp" />

    <Button android:id="@+id/save" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="14dp"
        android:text="@string/config_save" />
</LinearLayout>
